<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>HospitalitySpa</RootNamespace>
        <AssemblyName>HospitalitySpa</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <OutputPath>..\..\1.7\Assemblies\</OutputPath>
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <!-- Keep the existing hand-written Properties\AssemblyInfo.cs; don't let the SDK generate a duplicate. -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Path to Dubs Bad Hygiene's assembly (the file is named BadHygiene.dll), needed only to COMPILE.
             Default = Steam Workshop "Full" edition (id 836308268), RimWorld 1.6. Override if your install differs. -->
        <BadHygieneDll Condition="'$(BadHygieneDll)' == ''">E:\SteamLibrary\steamapps\workshop\content\294100\836308268\1.6\Assemblies\BadHygiene.dll</BadHygieneDll>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer">
            <Version>1.0.3</Version>
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Krafs.Rimworld.Ref">
            <Version>1.7.4977-alpha.1</Version>
            <ExcludeAssets>runtime</ExcludeAssets>
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Harmony is provided at runtime by the Harmony/RimWorld load; compile-only here. -->
        <PackageReference Include="Lib.Harmony" Version="*" ExcludeAssets="runtime" />
    </ItemGroup>
    <ItemGroup>
        <Publicize Include="Assembly-CSharp" />
    </ItemGroup>

    <!--
      Dubs Bad Hygiene is a hard COMPILE dependency (HotTubJob/SaunaJob/SwimmingJob/HarmonyPatches
      reference its types). It is NOT redistributed with this mod (Private=false) and is loaded from
      the Workshop at runtime. To build, install Dubs Bad Hygiene and point this HintPath at its DLL.
    -->
    <ItemGroup>
      <Reference Include="BadHygiene">
        <HintPath>$(BadHygieneDll)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>

    <!-- Surface the mod's content XML (Defs, Patches, Languages, About...) in the IDE so it's reachable alongside the source -->
    <ItemGroup>
        <None Include="..\..\**\*.xml" Exclude="..\..\Source\**\*.xml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
